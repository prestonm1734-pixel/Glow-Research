{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/welcome", "destination": "/welcome.html" },
    { "source": "/shop", "destination": "/shop.html" }
  ],
  "redirects": [
    { "source": "/peptides/glp-3-rt/", "destination": "/product/g3-r/", "permanent": true },
    { "source": "/peptides/glp-3-rt", "destination": "/product/g3-r/", "permanent": true },
    { "source": "/product/glp-3-rt/", "destination": "/product/g3-r/", "permanent": true },
    { "source": "/product/glp-3-rt", "destination": "/product/g3-r/", "permanent": true },
    { "source": "/peptides/glp-1-sm/", "destination": "/product/g1-s/", "permanent": true },
    { "source": "/peptides/glp-1-sm", "destination": "/product/g1-s/", "permanent": true },
    { "source": "/product/glp-1-sm/", "destination": "/product/g1-s/", "permanent": true },
    { "source": "/product/glp-1-sm", "destination": "/product/g1-s/", "permanent": true },
    { "source": "/peptides/glp-2-tr/", "destination": "/product/g2-t/", "permanent": true },
    { "source": "/peptides/glp-2-tr", "destination": "/product/g2-t/", "permanent": true },
    { "source": "/product/glp-2-tr/", "destination": "/product/g2-t/", "permanent": true },
    { "source": "/product/glp-2-tr", "destination": "/product/g2-t/", "permanent": true },
    { "source": "/peptides/glp-2-tz/", "destination": "/product/g2-t/", "permanent": true },
    { "source": "/peptides/glp-2-tz", "destination": "/product/g2-t/", "permanent": true },
    { "source": "/product/glp-2-tz/", "destination": "/product/g2-t/", "permanent": true },
    { "source": "/product/glp-2-tz", "destination": "/product/g2-t/", "permanent": true },
    { "source": "/peptides/:slug/", "destination": "/product/:slug/", "permanent": true },
    { "source": "/peptides/:slug", "destination": "/product/:slug", "permanent": true },
    { "source": "/affiliates.html", "destination": "/", "permanent": true },
    { "source": "/returns.html", "destination": "/return-policy.html", "permanent": true },
    { "source": "/peptides.html", "destination": "/shop", "permanent": true },
    { "source": "/product/:slug/:page((?!index\\.html$).+\\.html)", "destination": "/:page", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/welcome",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/shop",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/product/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
